---
import { Image } from "astro:assets";

interface Props {
    name: string;
    position: string;
    image: string;
}
const { name, position, image } = Astro.props;
---
<div class="m-2 w-22 ">
    <div class="bg-gray-300 border border-black
               shadow-[3px_3px_0px_#000000] ">
        <Image src={image} alt={name} width={100} height={100} class="w-20 h-20 object-cover" />
    </div>
    <div class="flex flex-col">
        <p class="text-sm ml-2 my-1">{name}</p>
        <p class="text-sm ml-2 my-0 font-bold">{position}</p>
    </div>
</div>