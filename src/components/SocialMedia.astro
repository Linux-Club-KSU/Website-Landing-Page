---
import Button from './Button.astro'
import { Icon } from 'astro-icon/components';
---

<div class="flex flex-col mt-6 ml-9">
    <div class="mb-2">
        <Button href="https://discord.gg/8pksdT2jQT">
            <Icon name="Logo-Discord--Streamline-Pixel" class="text-blue-800 w-6 h-6 "/>
            <span>Join Discord</span>
        </Button>
    </div>
    <div class="mb-2">
        <Button href="https://github.com/Linux-Club-KSU">
            <Icon name="Coding-Apps-Websites-Programming-Browser--Streamline-Pixel" class="text-red-500 w-6 h-6" />
            <span>GitHub</span>
        </Button>
    </div>
    <div class="mb-2">
        <Button href="https://owllife.kennesaw.edu/organization/linuxclub">
            <Icon name="Logo-Discord--Streamline-Pixel" class="text-yellow-500 w-6 h-6" />
            <span>OwlLife</span>
        </Button>
    </div>
    <div class="mb-2">
        <Button href="https://www.instagram.com/linuxclubksu/">
            <Icon name="Logo-Social-Media-Old-Instagram--Streamline-Pixel" class="text-blue-500 w-6 h-6" />
            <span>Instagram</span>
        </Button>
    </div>
    <div class="mb-2"   >
        <Button href="https://www.linkedin.com/groups/13173108/">
            <Icon name="Logo-Linkedin--Streamline-Pixel" class="text-blue-800 w-6 h-6" />
            <span>Linkden</span>
        </Button>
    </div>
</div>
